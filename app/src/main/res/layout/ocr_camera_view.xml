<helium314.keyboard.latin.ocr.OcrCameraView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ocr_camera_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:soundEffectsEnabled="false"
    android:visibility="gone"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/ocr_preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Transparent touch barrier above preview to consume all preview touches and handle focus -->
    <View
        android:id="@+id/ocr_touch_shield"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:soundEffectsEnabled="false" />

    <!-- Status indicator (e.g. No text detected) - no pill background -->
    <TextView
        android:id="@+id/ocr_status_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@null"
        android:textColor="#FFFFFF"
        android:text="@string/ocr_no_text_detected"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone" />

    <!-- Unified Bottom Controls Bar: Flash (left), Shutter (center), Close (right) -->
    <LinearLayout
        android:id="@+id/ocr_controls_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/btn_ocr_flash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_flash_off"
            android:background="@drawable/btn_circle_translucent"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:contentDescription="@string/ocr_flash_button_desc"
            app:tint="#FFFFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp">

            <ImageButton
                android:id="@+id/btn_ocr_shutter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_shutter"
                android:scaleType="fitCenter"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ocr_shutter_button_desc" />

            <ProgressBar
                android:id="@+id/ocr_shutter_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:indeterminate="true"
                android:indeterminateTint="#FFFFFFFF"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_ocr_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/btn_circle_translucent"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:contentDescription="@string/dialog_close"
            app:tint="#FFFFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ocr_plugin_required_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:padding="24dp"
        android:visibility="gone"
        android:background="#DD000000">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_ocr"
            android:contentDescription="" />

        <TextView
            android:id="@+id/ocr_plugin_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ocr_plugin_required_title"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ocr_plugin_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ocr_plugin_required_summary"
            android:textColor="#CCCCCC"
            android:gravity="center"
            android:textSize="12sp" />

        <Button
            android:id="@+id/ocr_btn_load_plugin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ocr_plugin_open_settings" />
    </LinearLayout>

</helium314.keyboard.latin.ocr.OcrCameraView>
